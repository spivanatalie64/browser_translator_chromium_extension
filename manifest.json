{
  "manifest_version": 3,
  "name": "Eilatan Lingo — Two Way Translator",
  "version": "1.1.0",
  "description": "Type in English and the site gets its own language. Read the site and you get English. Autodetect, both ways, no keys needed.",
  "default_locale": null,
  "permissions": ["storage", "commands"],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Eilatan Lingo",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-page-translation": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Toggle page translation (site text → English)"
    },
    "toggle-input-translation": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "Toggle input translation (your typing → site language)"
    }
  }
}
