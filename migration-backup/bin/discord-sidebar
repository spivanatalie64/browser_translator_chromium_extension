#!/usr/bin/env bash
# Discord Sidebar Launcher
# Opens Discord in IceCat with mods and tiles it as a right-side chat panel
set -euo pipefail

PROFILE="discord"
DISCORD_URL="https://discord.com/app"
SIDEBAR_WIDTH=480

# Get screen dimensions
read -r SCREEN_W SCREEN_H < <(xdotool getdisplaygeometry 2>/dev/null || echo "1920 1080")
SIDEBAR_X=$((SCREEN_W - SIDEBAR_WIDTH))

# Kill any existing discord sidebar window
WIN_ID=$(xdotool search --name "discord.com" 2>/dev/null | tail -1 || true)
if [ -n "$WIN_ID" ] && [ "$WIN_ID" != "0" ]; then
    # Focus and re-tile existing window
    xdotool windowactivate "$WIN_ID"
    xdotool windowsize "$WIN_ID" "$SIDEBAR_WIDTH" "$SCREEN_H"
    xdotool windowmove "$WIN_ID" "$SIDEBAR_X" 0
    exit 0
fi

# Launch IceCat with discord profile
icecat -P "$PROFILE" "$DISCORD_URL" >/dev/null 2>&1 &

# Wait for window to appear, then position it
for i in $(seq 1 20); do
    sleep 0.3
    WIN_ID=$(xdotool search --name "discord.com" 2>/dev/null | tail -1 || true)
    if [ -n "$WIN_ID" ] && [ "$WIN_ID" != "0" ]; then
        xdotool windowsize "$WIN_ID" "$SIDEBAR_WIDTH" "$SCREEN_H"
        xdotool windowmove "$WIN_ID" "$SIDEBAR_X" 0
        xdotool windowactivate "$WIN_ID"
        break
    fi
done
