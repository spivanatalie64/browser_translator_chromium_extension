#!/usr/bin/env bash
# Natalie's WhatsApp wrapper
# Opens WhatsApp Web in IceCat's dedicated "whatsapp" profile
# Usage: whatsapp [extra-url]

set -euo pipefail

PROFILE="whatsapp"
WHATSAPP_URL="https://web.whatsapp.com"

# If IceCat is already running on this profile, just hand it the URL
if pgrep -f "icecat.*-P $PROFILE" >/dev/null 2>&1; then
    exec icecat "https://web.whatsapp.com" >/dev/null 2>&1 &
    exit 0
fi

exec icecat -P "$PROFILE" "${1:-$WHATSAPP_URL}" >/dev/null 2>&1 &
