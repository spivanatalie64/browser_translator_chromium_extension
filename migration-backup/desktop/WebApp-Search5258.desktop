[Desktop Entry]
Version=1.0
Name=Search
Comment=Web App
Exec=sh -c 'XAPP_FORCE_GTKWINDOW_ICON="/home/natalie/.local/share/ice/icons/Search.png" icecat --class WebApp-Search5258 --name WebApp-Search5258 --profile /home/natalie/.local/share/ice/firefox/Search5258 --no-remote "https://html.duckduckgo.com/html/"'
Terminal=false
